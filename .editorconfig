# Applies to the whole repository: both version projects and common/.
# Deliberately limited to the portable subset every editor honours.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{java,gradle}]
indent_size = 4

[*.{yml,yaml,json,mcmeta,info,toml,xml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2
tab_width = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

# Vendored by the Gradle wrapper; leave exactly as generated.
[gradlew]
indent_size = 4
max_line_length = unset
